# Vapi dashboard -> API Keys -> Private Key
VAPI_API_KEY=

# Must match backend/.env's VAPI_WEBHOOK_SECRET exactly
VAPI_WEBHOOK_SECRET=change-me

# Public HTTPS URL of the FastAPI backend (ngrok URL during dev, real host later)
BACKEND_URL=https://your-ngrok-or-deployed-url.example.com

# OpenRouter API key (openrouter.ai/keys)
OPENROUTER_API_KEY=
# Any OpenRouter model that supports function/tool calling. Free-tier
# reasoning models (tried: nvidia/nemotron-3-super-120b-a12b:free) were
# abandoned after real calls showed the model's internal reasoning trace
# being spoken aloud instead of a clean reply - Vapi's generic OpenRouter
# integration doesn't send the parameter that suppresses it for that model.
# gpt-4o-mini costs fractions of a cent per call and has been reliable in
# every real test call - see system_prompt.md's design notes for the story.
OPENROUTER_MODEL=openai/gpt-4o-mini

# ElevenLabs dashboard -> Profile -> API Key
ELEVENLABS_API_KEY=
# Any voice id from your ElevenLabs voice library (default = "Rachel")
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# A second real voice id from your account, used only if the primary fails mid-call
ELEVENLABS_FALLBACK_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17

# Optional: request a specific area code for the free Vapi trial number
PHONE_AREA_CODE=
