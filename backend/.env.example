# MongoDB Atlas connection string (from Atlas dashboard -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=carecloud

# Shared secret Vapi must send back to us on every tool-call / end-of-call webhook
# (set the same value as a header in the Vapi server URL config so random callers
# on the internet can't POST fake patient data into our webhook)
VAPI_WEBHOOK_SECRET=change-me

# Comma-separated origins allowed to call the API from a browser (Next.js dashboard)
CORS_ORIGINS=http://localhost:3000

# Used only by frontend/ - the FastAPI base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
